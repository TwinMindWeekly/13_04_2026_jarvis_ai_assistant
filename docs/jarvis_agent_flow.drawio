        <mxCell id="example-label" value="&lt;b&gt;VÍ DỤ: &quot;Tìm thời tiết Hà Nội rồi gửi notification cho tôi&quot;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="845" width="500" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="ex1" value="&lt;b&gt;Vòng 1: THINK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;LLM đọc tin nhắn&lt;br&gt;→ Cần tìm thời tiết&lt;br&gt;→ Chọn web_search&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="70" y="875" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ex2" value="&lt;b&gt;Vòng 1: ACT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;web_search(&lt;br&gt;  query=&quot;thời tiết&lt;br&gt;  Hà Nội hôm nay&quot;&lt;br&gt;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="230" y="875" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ex3" value="&lt;b&gt;Vòng 1: OBSERVE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Kết quả:&lt;br&gt;[{title: &quot;Hà Nội&lt;br&gt;32°C nắng&quot;, ...}]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="390" y="875" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ex4" value="&lt;b&gt;Vòng 2: THINK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Đã có thời tiết&lt;br&gt;→ Cần gửi notification&lt;br&gt;→ Chọn notification&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="550" y="875" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ex5" value="&lt;b&gt;Vòng 2: ACT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;system_notification(&lt;br&gt;  title=&quot;Thời tiết&quot;&lt;br&gt;  message=&quot;32°C&quot;&lt;br&gt;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="710" y="875" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ex6" value="&lt;b&gt;Vòng 2: OBSERVE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Notification đã gửi&lt;br&gt;{success: true}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="870" y="875" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ex7" value="&lt;b&gt;Vòng 3: KẾT THÚC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;LLM trả lời:&lt;br&gt;&quot;Thời tiết Hà Nội&lt;br&gt;hôm nay 32°C, đã&lt;br&gt;gửi notification&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#006600;fontSize=9;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1030" y="875" width="140" height="80" as="geometry"/>
        </mxCell>

