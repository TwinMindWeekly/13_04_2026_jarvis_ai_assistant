          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1190" y="460"/>
              <mxPoint x="1190" y="270"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a10-label" value="&lt;font style=&quot;font-size:9px;color:green&quot;&gt;&lt;b&gt;Trả lời cuối cùng&lt;br&gt;(text, không gọi tool)&lt;/b&gt;&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="a10">
          <mxGeometry x="0.3" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- Streaming events back -->
        <mxCell id="a11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1a56db;strokeWidth=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="observe" target="render" parent="1">
