# LLM Provider API Keys
OPENAI_API_KEY=
GOOGLE_API_KEY=AIza-your-google-key
ANTHROPIC_API_KEY=
GROQ_API_KEY=gsk-your-groq-key
SAMBANOVA_API_KEY=your-sambanova-key

# Proxy base URLs (e.g. Antigravity Manager) — leave empty for direct access
# OPENAI_BASE_URL=http://localhost:18080/v1
# GEMINI_BASE_URL=http://localhost:18080/gemini/v1
# ANTHROPIC_BASE_URL=http://localhost:18080/v1

# Chat/Agent — "auto" tries: groq → gemini → sambanova → openai → claude → ollama
# Set a specific provider to skip fallback (e.g. "groq", "openai", "gemini")
DEFAULT_PROVIDER=auto
DEFAULT_MODEL=

# Per-provider default models
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_MODEL=claude-sonnet-4-6

# Groq config (free: 1000 req/day, Llama 3.3 70B with tool calling)
GROQ_MODEL=llama-3.3-70b-versatile

# SambaNova config (free: Meta-Llama-3.3-70B)
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# Wikilink generation — Ollama local (free, no API key)
WIKILINK_PROVIDER=ollama
WIKILINK_MODEL=huihui_ai/llama3.2-abliterate:3b

# Email (IMAP/SMTP) — for Gmail use App Password
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=your@gmail.com
# IMAP_PASSWORD=your-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM_NAME=JARVIS

# Image generation (optional — uses OPENAI_API_KEY for DALL-E)
# STABILITY_API_KEY=sk-...

# Code runner (optional — path to Godot executable for GDScript)
# GODOT_PATH=C:/Godot/Godot_v4.4-stable_win64.exe

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
